<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Agent Service. Bewusst ohne App Sandbox (ADR-0020), Hardened Runtime über ENABLE_HARDENED_RUNTIME. Einziger CloudKit-/CKSyncEngine-Besitzer am Mac (ADR-0019); aps-environment laut CKSyncEngine-Doku erforderlich (Spike S1). CloudKit-Umgebung in allen Builds Production (ADR-0027). -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.aps-environment</key>
	<string>$(SR_APS_ENVIRONMENT)</string>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>$(SR_CLOUDKIT_ENVIRONMENT)</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(SR_CLOUDKIT_CONTAINER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(SR_APP_GROUP_MAC)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(SR_DEVELOPMENT_TEAM).$(SR_AGENT_BUNDLE_ID)</string>
		<string>$(SR_KEYCHAIN_SHARED_GROUP)</string>
	</array>
</dict>
</plist>
