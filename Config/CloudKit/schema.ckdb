DEFINE SCHEMA

    RECORD TYPE ADR (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        baseVersion     INT64 QUERYABLE SORTABLE,
        entityId        STRING QUERYABLE SEARCHABLE SORTABLE,
        isDeleted       INT64 QUERYABLE SORTABLE,
        modifiedAt      TIMESTAMP QUERYABLE SORTABLE,
        operationId     STRING QUERYABLE SEARCHABLE SORTABLE,
        originDeviceId  STRING QUERYABLE SEARCHABLE SORTABLE,
        payload         ENCRYPTED BYTES,
        payloadAsset    ASSET,
        schemaVersion   INT64 QUERYABLE SORTABLE,
        version         INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

